root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# gofmt mandates tabs in Go source
[*.go]
indent_style = tab

[{go.mod,go.sum}]
indent_style = tab

# Make requires tabs for recipe lines
[Makefile]
indent_style = tab

[*.{yml,yaml,json,md,sh}]
indent_size = 2
