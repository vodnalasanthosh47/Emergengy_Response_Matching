# Copy to deploy/compose/.env (git-ignored) and change the values. Docker Compose reads
# it automatically. Without it, Compose falls back to the local-only defaults in
# docker-compose.yml.
RABBITMQ_USER=emergency
RABBITMQ_PASSWORD=change-me
# Matching Service rematch sweeper (default 2m each): how often waiting requests are
# re-queued, and how long a request may stay PENDING before it counts as waiting.
REMATCH_INTERVAL=2m
REMATCH_PENDING_AGE=2m
