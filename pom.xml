<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven parent for the Java application services (spec §6).

  Spring Boot's parent gives us its dependency management (one tested set of library
  versions) and plugin configuration. Each service is a module below; `common` holds
  the code they share (storage client, geohash, DTOs, events).

  Build everything:   mvn verify
  One service only:   mvn -pl services/request_service -am verify
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.emergency</groupId>
  <artifactId>emergency-response</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Emergency Response Matching</name>

  <modules>
    <module>common</module>
    <module>services/request_service</module>
    <!-- services/resource_service and services/matching_service are added by their own branches -->
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.emergency</groupId>
        <artifactId>common</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
